# Copy to .env.local and adjust if needed.
# Backend must be running at this URL (e.g. cargo run -p apex-edge).
VITE_API_BASE_URL=http://localhost:3000

# Dev sign-in: the simulator mints its own HS256 "external" token. These must match the hub's
# APEX_EDGE_AUTH_EXTERNAL_ISSUER / _AUDIENCE / _HS256_SECRET. Use a random local-only value.
VITE_AUTH_EXTERNAL_ISSUER=https://issuer.example
VITE_AUTH_EXTERNAL_AUDIENCE=mpos
VITE_AUTH_EXTERNAL_HS256_SECRET=
